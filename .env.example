# ---------------------------------------------------------------
# Copy to .env.local. Never commit real values.
# With no Supabase values set, the app runs on the built-in DEMO
# dataset (clearly labelled in the UI).
# ---------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 2) — auth, Postgres, storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only

# Data source: "demo" | "supabase"
DATA_SOURCE=demo

# Stripe (Phase 6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (Phase 5)
RESEND_API_KEY=
EMAIL_FROM="Forecourt <no-reply@example.co.uk>"

# Vehicle data (Phase 7) — authorised providers only
DVLA_VES_API_KEY=                   # DVLA Vehicle Enquiry Service
DVSA_MOT_CLIENT_ID=                 # DVSA MOT History API (OAuth)
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_API_KEY=
VEHICLE_DATA_PROVIDER_KEY=          # spec / valuation provider (commercial)

# Postcodes — postcodes.io is free/open; set if self-hosting
POSTCODES_API_URL=https://api.postcodes.io

# AI-assisted descriptions (Phase 3)
ANTHROPIC_API_KEY=

# Rate limiting (Phase 8) — e.g. Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error logging (Phase 8) — e.g. Sentry
SENTRY_DSN=
